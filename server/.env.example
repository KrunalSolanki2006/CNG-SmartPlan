# CNG SmartPlan - Backend Environment Configuration Example
# Copy to .env in server/ for local configuration overrides

# Server Environment Mode: development | production | test
ENVIRONMENT=development

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Path to Data Directory (defaults to ../CNG_SmartPlan_Data relative to server/)
DATA_DIR=../CNG_SmartPlan_Data

# Allowed CORS Origins (comma-separated if multiple)
CORS_ORIGINS=http://localhost:5173

